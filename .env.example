# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — or the legacy anon key as NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_…) or legacy service_role key — SERVER ONLY, never NEXT_PUBLIC_.
# Lets /api/auth/register create already-confirmed users. Without it, registration falls back
# to the normal sign-up (email confirmation, if enabled in Supabase) with a local profile.
SUPABASE_SECRET_KEY=

# OpenAI → https://platform.openai.com/api-keys (server-side only)
OPENAI_API_KEY=
# Models per plan (FREE / PRO / MAX / MAX deep reasoning)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_PRO=gpt-4o
OPENAI_MODEL_MAX=gpt-4o
OPENAI_MODEL_REASONING=o3-mini

# goszakup.gov.kz OWS API token (issued by the Unified Operator on request).
# Leave empty to use the bundled demo lots.
GOSZAKUP_TOKEN=

# Telegram bot from @BotFather (server-side only). Enables alerts + account linking.
TELEGRAM_BOT_TOKEN=

# Public URL of the deployed app — used for the "Open analysis" button in Telegram.
# Telegram rejects localhost links; leave empty in local dev (link goes into the text).
NEXT_PUBLIC_APP_URL=

# Card payments (Visa / Mastercard) via CloudPayments — merchant cabinet → Sites → API.
# The webhook "Pay" must point to https://<your-domain>/api/billing/cloudpayments/pay
# and needs SUPABASE_SECRET_KEY to store the subscription.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# Without CloudPayments keys a clearly-labelled test checkout activates plans locally.
# Set to "off" to disable it (always do so in production).
PAYMENTS_TEST_MODE=
