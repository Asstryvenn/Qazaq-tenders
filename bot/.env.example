# Скопируйте в bot/.env и заполните. Файл .env не коммитится.

# Токен ОТДЕЛЬНОГО бота от @BotFather (не бота уведомлений сайта — см. README)
BOT_TOKEN=

# OpenAI: извлечение фактов (gpt-4o-mini / gpt-4o) и распознавание голоса (Whisper)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Актуальный каталог/ERP/маркетплейс поставщиков. Контракт ответа описан в suppliers.py.
# Без обоих значений, при 503 или пустой выдаче включается явно помеченный DEMO/Smart AI fallback.
# Его значения не считаются верифицированными и не повышают достоверность расчёта.
SUPPLIER_CATALOG_URL=
SUPPLIER_CATALOG_API_KEY=

# Лента лотов в едином формате (сайт Qazaq Tenders). Без сети бот берёт data/sample_tenders.json
QT_API_BASE=https://www.qazaqtenders.kz

# SQLite с профилями и кэшем лотов
DB_PATH=

# AI-действий в сутки на чат (голос, документ, AI-поиск). 0 — без лимита
AI_DAILY_LIMIT=30

# Уведомления о новых лотах: период проверки (мин) и минимальный TOS
ALERT_INTERVAL_MIN=30
ALERT_MIN_TOS=60

# Режим webhook через api.py (uvicorn). Пусто → бот работает через polling (python bot.py)
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# ATI.SU — живые ставки автоперевозок (Фура/Газель)
ATI_SU_CLIENT_ID=
ATI_SU_API_KEY=
ATI_RUB_TO_KZT=6.3
